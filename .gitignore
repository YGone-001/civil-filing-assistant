# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and PyInstaller outputs
build/
dist/
*.egg-info/
*.spec

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local configuration, credentials, and logs
.env
.env.*
!.env.example
*.log

# Generated legal documents and local test artifacts
/test_samples/
/*.docx
/*_vs_*/

# Local encrypted case drafts and their same-directory write artifacts.
# Drafts contain personal case data and are protected with the Windows user
# key, so they are never portable between machines and never belong in Git.
*.cfdraft
.cfadraft-*

# Local audit/quality reports (kept out of the repository per project policy)
/reports/
